%% C4 level 3, components - Customer Management
%% Two modules in one bounded context: customers, vehicles.
%% A module reaches another through a port it declares and a gateway that calls the other module's
%% use cases, exported from its index.ts.
%% Detail: docs/architecture/low-level-design/{customers,vehicles}.md

C4Component
  title Components - Customer Management

  Person(advisor, "Service advisor / Administrator", "Registers and maintains customers and vehicles")
  Person(customer, "Customer", "Reads their own record and vehicles")

  Container_Boundary(app, "NestJS application") {

    Boundary(customers, "customers") {
      Component(custCtl, "CustomersController", "Controller", "Registration, own record, administration")
      Component(registerCust, "RegisterCustomerUseCase", "Use case", "Creates over an existing identity, or opens the account and then saves the customer, as steps")
      Component(updateCust, "UpdateCustomerUseCase", "Use case", "Address and phone")
      Component(getCust, "GetCustomerUseCase", "Use case", "One customer, whatever its status; CustomerNotFoundError when there is none")
      Component(custByUser, "GetCustomerByUserIdUseCase", "Use case", "Resolves the customer behind a token")
      Component(custAgg, "Customer", "Aggregate", "Address, PhoneNumber, one identity per customer")
      Component(custRepo, "TypeOrmCustomerRepository", "Repository", "Honours an ambient transaction")
      Component(custQuery, "TypeOrmCustomerQueryAdapter", "Query port", "CustomerQueryPort, composes the listing with the users from identity")
      Component(accountsGw, "CustomerAccountsGateway", "Gateway", "Implements CustomerAccounts by calling identity")
      Component(accountSteps, "TypeOrmPendingAccountSteps", "Outbox", "The discard steps over customer_account_steps; claims due steps with SKIP LOCKED")
      Component(accountApplier, "AccountStepApplier / AccountStepProcessor", "Service and processor", "Discard the accounts of steps that fell due, at bootstrap and on an interval")
      Component(custKeys, "CustomerKeyResolver", "Key resolver", "Customer UUID to internal key and back, for other modules")
    }

    Boundary(vehicles, "vehicles") {
      Component(vehCtl, "VehiclesController", "Controller", "Registration, own vehicles, administration")
      Component(registerVeh, "RegisterVehicleUseCase", "Use case", "Refuses an inactive owner")
      Component(myVehicles, "GetMyVehiclesUseCase", "Use case", "Resolves the customer from the token, empty list when there is none")
      Component(getVeh, "GetVehicleUseCase", "Use case", "One vehicle, VehicleNotFoundError when there is none")
      Component(vehAgg, "Vehicle", "Aggregate", "LicensePlate, VehicleYear, plate unique while not removed")
      Component(vehRepo, "TypeOrmVehicleRepository", "Repository", "")
      Component(vehQuery, "TypeOrmVehicleQueryAdapter", "Query port", "VehicleQueryPort")
      Component(ownersGw, "VehicleOwnersGateway", "Gateway", "Implements VehicleOwners by calling customers")
      Component(vehKeys, "VehicleKeyResolver", "Key resolver", "Vehicle UUID to internal key and back, for other modules")
    }
  }

  Component_Ext(identity, "identity", "Module", "Owns the account, the name, the email and the document")
  Component_Ext(workOrders, "work-orders", "Module", "Opens work orders against a customer and a vehicle")
  ContainerDb(pg, "PostgreSQL", "PostgreSQL 16", "customers, customer_account_steps, vehicles")

  Rel(advisor, custCtl, "Registers and maintains", "HTTPS")
  Rel(advisor, vehCtl, "Registers and maintains", "HTTPS")
  Rel(customer, custCtl, "Reads and updates their own record", "HTTPS")
  Rel(customer, vehCtl, "Lists their own vehicles", "HTTPS")

  Rel(custCtl, registerCust, "Calls")
  Rel(custCtl, updateCust, "Calls")
  Rel(custCtl, custByUser, "Calls")
  Rel(registerCust, custAgg, "Creates")
  Rel(registerCust, custRepo, "Saves")
  Rel(registerCust, accountsGw, "Opens or checks the account through the CustomerAccounts port, and discards it when the registration fails")
  Rel(registerCust, accountSteps, "Arms the discard step, and disarms it in the transaction that saves the customer")
  Rel(accountApplier, accountSteps, "Claims due steps, records the outcome")
  Rel(accountApplier, accountsGw, "Discards the account of a step")
  Rel(getCust, custQuery, "Reads")
  Rel(custByUser, custQuery, "Reads")
  Rel(vehCtl, registerVeh, "Calls")
  Rel(vehCtl, myVehicles, "Calls")
  Rel(registerVeh, vehAgg, "Creates")
  Rel(registerVeh, vehRepo, "Saves")
  Rel(registerVeh, ownersGw, "Resolves the owner through the VehicleOwners port")
  Rel(myVehicles, ownersGw, "Resolves the customer through the VehicleOwners port")
  Rel(myVehicles, vehQuery, "Reads")
  Rel(getVeh, vehQuery, "Reads")

  Rel(accountsGw, identity, "Calls through index.ts: opens the account under a chosen id, discards it, reads the user and its roles", "cross-module")
  Rel(custQuery, identity, "Calls through index.ts: name, email and document of each customer", "cross-module")
  Rel(custRepo, identity, "Calls through index.ts: user UUID to key", "cross-module")
  Rel(ownersGw, getCust, "Calls through index.ts: the owning customer", "cross-module")
  Rel(ownersGw, custByUser, "Calls through index.ts: token to customer", "cross-module")
  Rel(vehRepo, custKeys, "Calls through index.ts: customer UUID to key", "cross-module")
  Rel(workOrders, getCust, "Calls through index.ts: customer of a work order", "cross-module")
  Rel(workOrders, getVeh, "Calls through index.ts: vehicle of a work order", "cross-module")
  Rel(workOrders, custKeys, "Calls through index.ts: customer UUID to key", "cross-module")
  Rel(workOrders, vehKeys, "Calls through index.ts: vehicle UUID to key", "cross-module")

  Rel(custRepo, pg, "Reads and writes", "TCP")
  Rel(accountSteps, pg, "Reads and writes the outbox", "TCP")
  Rel(vehRepo, pg, "Reads and writes", "TCP")
  Rel(custQuery, pg, "Reads", "TCP")
  Rel(vehQuery, pg, "Reads", "TCP")

  UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")

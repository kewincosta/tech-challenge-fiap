%% C4 level 3, components - Workshop Operations
%% One module, work-orders, and the most crossings in the system: it reads customers, vehicles,
%% services and identity, and moves stock in inventory through steps: it records each step in its
%% own outbox and inventory commits the stock side in a transaction of its own. Each crossing is a
%% port that work-orders declares and a gateway that calls the other module's use cases.
%% Detail: docs/architecture/low-level-design/work-orders.md

C4Component
  title Components - Workshop Operations

  Person(advisor, "Service advisor", "Opens, assigns, delivers, cancels")
  Person(mechanic, "Mechanic", "Diagnoses, withdraws, returns, completes")
  Person(customer, "Customer", "Decides on the budget, follows their own work orders")

  Container_Boundary(app, "NestJS application") {

    Boundary(workOrders, "work-orders") {
      Component(woCtl, "WorkOrdersController", "Controller", "24 routes, addressed by work order number")
      Component(lifecycle, "Lifecycle use cases", "Use cases", "Create, diagnose, budget, approve, complete, discount; deliver and cancel record a settle or write-off step with the save")
      Component(stockCmds, "WithdrawPartsUseCase / ReturnPartsUseCase", "Use cases", "Withdraw consumes the stock, records a confirmation step with the save and undoes the consumption when the save fails; return records a restore step with the save")
      Component(queries, "Query use cases", "Use cases", "Get, list, own, trail, average execution time; WorkOrderNotFoundError for an unknown number")
      Component(authorizers, "Budget / Completion / Cancellation authorizers", "Services", "Owner-or-permission rules the guard cannot express")
      Component(gateways, "Gateways", "Gateways", "CustomerDirectory, VehicleDirectory, ServiceCatalog, PartCatalog, StockLedger and WorkOrderActors")
      Component(statusMail, "StatusMailSubscriber / SmtpMailer", "Subscriber and adapter", "On each WorkOrderStatusChanged, after the commit, composes the e-mail and sends it through the Mailer port; a failure is logged and not repeated")
      Component(stockSteps, "TypeOrmPendingStockSteps", "Outbox", "The stock steps over work_order_stock_steps; claims due steps with SKIP LOCKED, in recorded order within a work order, an undo excepted")
      Component(stepApplier, "StockStepApplier / StockStepProcessor", "Service and processor", "Apply the stock steps that fell due through StockLedger, at bootstrap and on an interval")
      Component(woAgg, "WorkOrder", "Aggregate", "Budget, WorkOrderServiceItem, WorkOrderPartItem, seven statuses")
      Component(woRepo, "TypeOrmWorkOrderRepository", "Repository", "Ambient transaction, version guard, writes the trail in the same transaction")
      Component(woQuery, "TypeOrmWorkOrderQueryAdapter", "Query port", "Board, one work order, trail, customer-scoped reads")
      Component(metrics, "TypeOrmWorkOrderMetricsQueryAdapter", "Query port", "Average execution time, aggregated in SQL with EXISTS")
      Component(reads, "TypeOrmWorkOrderReads", "Adapter", "Implements the WorkOrderReads interface that inventory declares")
    }
  }

  Component_Ext(customers, "customers", "Module", "Customer of a work order, and the token-to-customer lookup")
  Component_Ext(vehicles, "vehicles", "Module", "Vehicle of a work order")
  Component_Ext(services, "services", "Module", "Catalog price frozen into a budget round")
  Component_Ext(inventory, "inventory", "Module", "Stock consumed, confirmed, returned, settled, written off")
  Component_Ext(identity, "identity", "Module", "The access of an actor, and the mechanic being assigned")
  Component_Ext(smtp, "SMTP server", "Mailpit, locally and in prod", "Takes the e-mails that tell the customer of each status change")
  ContainerDb(pg, "PostgreSQL", "PostgreSQL 16", "work_orders, work_order_services, work_order_parts, work_order_budgets, work_order_events, work_order_stock_steps")

  Rel(advisor, woCtl, "Opens, assigns, delivers, cancels", "HTTP")
  Rel(mechanic, woCtl, "Diagnoses, withdraws, returns, completes", "HTTP")
  Rel(customer, woCtl, "Approves or rejects, reads their own", "HTTP")

  Rel(woCtl, lifecycle, "Calls")
  Rel(woCtl, stockCmds, "Calls")
  Rel(woCtl, queries, "Calls")
  Rel(queries, woQuery, "Reads")
  Rel(queries, metrics, "Reads")
  Rel(lifecycle, authorizers, "Asks before acting")
  Rel(lifecycle, woAgg, "Loads, calls, saves")
  Rel(stockCmds, woAgg, "Loads, calls, saves")
  Rel(lifecycle, woRepo, "Saves")
  Rel(stockCmds, woRepo, "Saves")
  Rel(lifecycle, gateways, "Customer, vehicle, service, part and actor lookups")
  Rel(stockCmds, gateways, "StockLedger: consume the stock, and undo it when the save fails")
  Rel(stockCmds, stockSteps, "Arms the undo step, disarms it with the save and records the confirmation step; records the restore step with the save")
  Rel(lifecycle, stockSteps, "Records the settle and write-off steps with the save")
  Rel(stockCmds, stepApplier, "Applies the step it recorded, after the commit")
  Rel(lifecycle, stepApplier, "Applies the step it recorded, after the commit")
  Rel(stepApplier, stockSteps, "Claims due steps, records the outcome")
  Rel(stepApplier, gateways, "StockLedger: restore, undo, confirm, settle and write off")
  Rel(authorizers, gateways, "WorkOrderActors: what the caller may do")
  Rel(lifecycle, statusMail, "Publishes WorkOrderStatusChanged after the commit; the dispatcher does not wait")
  Rel(statusMail, gateways, "CustomerDirectory: the name and the e-mail of the customer")
  Rel(statusMail, smtp, "Sends the status e-mail", "SMTP")

  Rel(gateways, customers, "Calls through index.ts: customer of the work order, token to customer", "cross-module")
  Rel(gateways, vehicles, "Calls through index.ts: vehicle and its owner", "cross-module")
  Rel(gateways, services, "Calls through index.ts: service and its price when an item is added", "cross-module")
  Rel(gateways, inventory, "Calls through index.ts: the part, and the stock use cases", "cross-module")
  Rel(gateways, identity, "Calls through index.ts: the access of an actor, the assigned mechanic", "cross-module")
  Rel(woRepo, customers, "Calls through index.ts: customer UUID to key", "cross-module")
  Rel(woRepo, vehicles, "Calls through index.ts: vehicle UUID to key", "cross-module")
  Rel(woRepo, services, "Calls through index.ts: service UUID to key", "cross-module")
  Rel(woRepo, inventory, "Calls through index.ts: item UUID to key", "cross-module")
  Rel(woRepo, identity, "Calls through index.ts: user UUID to key", "cross-module")
  Rel(inventory, reads, "Reads work order data through WorkOrderReads", "cross-module")

  Rel(woRepo, pg, "Reads and writes, trail included", "TCP")
  Rel(stockSteps, pg, "Reads and writes the outbox", "TCP")
  Rel(woQuery, pg, "Reads", "TCP")
  Rel(metrics, pg, "Aggregates", "TCP")
  Rel(reads, pg, "Reads", "TCP")

  UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")

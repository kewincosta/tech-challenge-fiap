%% C4 level 3, components - Inventory
%% One module, inventory. Drawn because of the two arrows between it and work-orders: the six stock
%% use cases that work-orders calls, five in a transaction of their own and the confirmation in one
%% statement, and the WorkOrderReads interface that inventory declares and work-orders implements.
%% Every import between the two points from work-orders to inventory.
%% Detail: docs/architecture/low-level-design/inventory.md

C4Component
  title Components - Inventory

  Person(admin, "Administrator", "Creates items, replenishes, adjusts, reads the ledger")

  Container_Boundary(app, "NestJS application") {

    Boundary(inventory, "inventory") {
      Component(invCtl, "InventoryItemsController", "Controller", "Items, replenishments, adjustments, shortages, movement history")
      Component(createItem, "CreateInventoryItemUseCase", "Use case", "Adds an item")
      Component(deactivateItem, "DeactivateInventoryItemUseCase", "Use case", "Refuses while an open work order plans the item")
      Component(replenish, "ReplenishStockUseCase", "Use case", "Appends an INBOUND movement")
      Component(adjust, "AdjustStockUseCase", "Use case", "Appends an ADJUSTMENT, note required")
      Component(consume, "ConsumeStockBatchUseCase", "Use case", "Appends PENDING consumptions")
      Component(restore, "RestoreStockBatchUseCase", "Use case", "Draws down confirmed consumptions, appends RETURNs")
      Component(undo, "UndoConsumptionUseCase", "Use case", "Returns the units of an operation, whatever the status or confirmation of its consumptions")
      Component(confirm, "ConfirmConsumptionUseCase", "Use case", "Sets the confirmation time on the consumptions of an operation")
      Component(settle, "SettleStockMovementsUseCase", "Use case", "Confirmed PENDING to SETTLED")
      Component(writeOff, "WriteOffStockMovementsUseCase", "Use case", "Confirmed PENDING to WRITTEN_OFF")
      Component(queries, "Query use cases", "Use cases", "Items, shortages, movement history; InventoryItemNotFoundError for an unknown item")
      Component(itemAgg, "InventoryItem", "Aggregate", "Sku, StockQuantity, quantity never below zero")
      Component(movementAgg, "StockMovement", "Aggregate", "Append only, status only on a consumption")
      Component(invRepo, "TypeOrmInventoryItemRepository", "Repository", "Ambient transaction, row lock on the item")
      Component(invQuery, "TypeOrmInventoryQueryAdapter", "Query port", "Items, movement history, shortages")
      Component(itemKeys, "InventoryItemKeyResolver", "Key resolver", "Item UUID to internal key and back, for other modules")
      Component(readsPort, "WorkOrderReads", "Interface", "Work order key, outstanding demand, open work orders using an item")
    }
  }

  Component_Ext(workOrders, "work-orders", "Module", "Withdraws, returns, delivers and cancels, and implements WorkOrderReads")
  Component_Ext(identity, "identity", "Module", "Turns the actor's UUID into a key")
  ContainerDb(pg, "PostgreSQL", "PostgreSQL 16", "inventory_items, stock_movements, stock_movement_transitions")

  Rel(admin, invCtl, "Administers stock and reads the ledger", "HTTP")
  Rel(invCtl, createItem, "Calls")
  Rel(invCtl, deactivateItem, "Calls")
  Rel(invCtl, replenish, "Calls")
  Rel(invCtl, adjust, "Calls")
  Rel(invCtl, queries, "Calls: items, shortages, history")
  Rel(queries, invQuery, "Reads")
  Rel(deactivateItem, invQuery, "Asks which open work orders plan the item")

  Rel(workOrders, consume, "Calls through index.ts: withdrawal, in a transaction of its own", "cross-module")
  Rel(workOrders, restore, "Calls through index.ts: return, in a transaction of its own", "cross-module")
  Rel(workOrders, undo, "Calls through index.ts: undo of a withdrawal that did not complete, in a transaction of its own", "cross-module")
  Rel(workOrders, confirm, "Calls through index.ts: confirmation of the consumptions of a withdrawal, in one statement of its own", "cross-module")
  Rel(workOrders, settle, "Calls through index.ts: delivery, in a transaction of its own", "cross-module")
  Rel(workOrders, writeOff, "Calls through index.ts: cancellation, in a transaction of its own", "cross-module")
  Rel(workOrders, itemKeys, "Calls through index.ts: item UUID to key", "cross-module")
  Rel(workOrders, readsPort, "Implements it with TypeOrmWorkOrderReads, bound by WorkOrderReadsModule", "cross-module")
  Rel(invQuery, readsPort, "Reads outstanding demand and open work orders")
  Rel(invRepo, readsPort, "Reads the key of a work order")
  Rel(invRepo, identity, "Calls through index.ts: actor UUID to key", "cross-module")

  Rel(consume, itemAgg, "Decrements under a row lock")
  Rel(consume, movementAgg, "Appends")
  Rel(restore, movementAgg, "Appends RETURNs")
  Rel(undo, movementAgg, "Appends RETURNs")
  Rel(settle, movementAgg, "Appends a transition")
  Rel(writeOff, movementAgg, "Appends a transition")
  Rel(confirm, invRepo, "Sets the confirmation time")
  Rel(replenish, itemAgg, "Increments")
  Rel(invRepo, itemAgg, "Loads and saves")

  Rel(invRepo, pg, "Reads and writes", "TCP")
  Rel(invQuery, pg, "Reads", "TCP")

  UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")

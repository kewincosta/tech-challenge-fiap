%% C4 level 3, components - Identity & Access
%% One module, identity, with three areas: users, authentication, authorization.
%% An arrow between two areas is a direct call from one use case to another, inside the module.
%% An arrow from outside is a call through the module's index.ts, made by the gateway of the caller.
%% Detail: docs/architecture/low-level-design/identity/README.md

C4Component
  title Components - Identity & Access

  Person(person, "Any account holder", "Staff or customer")

  Container_Boundary(app, "NestJS application") {

    Boundary(users, "users") {
      Component(usersCtl, "UsersController", "Controller", "Registration, staff accounts, profile, administration")
      Component(registerUser, "RegisterUserUseCase", "Use case", "Registers the account, under the id the caller chose, and assigns CUSTOMER in one transaction")
      Component(discardAccount, "DiscardOpenedAccountUseCase", "Use case", "Removes an account another module opened; refuses one with a session or a customer")
      Component(changePassword, "ChangePasswordUseCase", "Use case", "Rehashes, clears the pending flag, ends every session")
      Component(getUser, "GetUserByIdUseCase", "Use case", "One user by id, UserNotFoundError when there is none")
      Component(verifyCredentials, "VerifyCredentialsUseCase", "Use case", "Checks the email and the password")
      Component(userAgg, "User", "Aggregate", "Email, PersonDocument, Password, PasswordHash, status")
      Component(userRepo, "TypeOrmUserRepository", "Repository", "Honours an ambient transaction")
      Component(hasher, "Argon2PasswordHasher", "Port adapter", "PasswordHasher")
      Component(userKeys, "UserKeyResolver", "Key resolver", "User UUID to internal key and back, for other modules")
    }

    Boundary(authn, "authentication") {
      Component(authCtl, "AuthController", "Controller", "Login, refresh, logout, session listing")
      Component(authenticate, "AuthenticateUserUseCase", "Use case", "Verifies credentials, opens a session")
      Component(refresh, "RefreshSessionUseCase", "Use case", "Rotates, or detects reuse and revokes")
      Component(logoutAll, "LogoutAllSessionsUseCase", "Use case", "Ends every active session of a user")
      Component(sessionAgg, "Session + RefreshToken", "Aggregate", "One active refresh token per session")
      Component(sessionRepo, "TypeOrmSessionRepository", "Repository", "")
      Component(revoked, "RedisRevokedSessionStore", "Port adapter", "RevokedSessionStore")
      Component(reuseLog, "RefreshTokenReuseSubscriber", "Subscriber", "Logs a warning when a refresh token is reused")
      Component(jwtGuard, "JwtAuthGuard", "Global guard", "Validates the token, checks revocation")
    }

    Boundary(authz, "authorization") {
      Component(rolesCtl, "Roles / Permissions / UserAccess controllers", "Controllers", "Role lifecycle and assignment")
      Component(assignRole, "AssignRoleToUserUseCase", "Use case", "Holds the escalation rule (ADR 0012)")
      Component(effective, "EffectiveAccessService", "Service", "Cache first, reader on miss")
      Component(roleAgg, "Role + Permission", "Aggregates", "System roles are immutable")
      Component(accessReader, "TypeOrmEffectiveAccessReader", "Port adapter", "One UNION query over user_roles and role_permissions")
      Component(accessCache, "RedisAccessCache", "Port adapter", "authz:access:{userId}, 60s TTL")
      Component(invalidator, "AccessCacheInvalidationSubscriber", "Subscriber", "Drops the entry on assignment change")
      Component(permGuard, "PermissionsGuard", "Global guard", "Requires every permission the route names")
    }
  }

  Component_Ext(customers, "customers", "Module", "Opens the account of a new customer, reads users")
  Component_Ext(workOrders, "work-orders", "Module", "Reads the access of an actor and the mechanic being assigned")
  ContainerDb(pg, "PostgreSQL", "PostgreSQL 16", "users, sessions, refresh_tokens, roles, permissions, user_roles, role_permissions")
  ContainerDb(redis, "Redis", "Redis 7", "Revoked sessions, effective access, rate limits")

  Rel(person, usersCtl, "Registers, manages the account", "HTTP")
  Rel(person, authCtl, "Logs in, refreshes, logs out", "HTTP")
  Rel(person, rolesCtl, "Administers roles and assignments", "HTTP")

  Rel(usersCtl, registerUser, "Calls")
  Rel(usersCtl, changePassword, "Calls")
  Rel(registerUser, userAgg, "Creates")
  Rel(registerUser, userRepo, "Saves")
  Rel(discardAccount, userRepo, "Deletes the user and its role assignments")
  Rel(registerUser, hasher, "Hashes")
  Rel(authCtl, authenticate, "Calls")
  Rel(authCtl, refresh, "Calls")
  Rel(authenticate, sessionAgg, "Opens")
  Rel(refresh, sessionAgg, "Rotates or revokes")
  Rel(authenticate, sessionRepo, "Saves")
  Rel(rolesCtl, assignRole, "Calls")
  Rel(assignRole, roleAgg, "Reads")
  Rel(effective, accessCache, "Reads and writes")
  Rel(effective, accessReader, "Reads on miss")
  Rel(permGuard, effective, "Resolves access")
  Rel(jwtGuard, revoked, "Checks revocation")

  Rel(registerUser, assignRole, "Calls: assigns CUSTOMER, same transaction", "between areas")
  Rel(changePassword, logoutAll, "Calls: ends every session", "between areas")
  Rel(authenticate, verifyCredentials, "Calls: verifies the credentials", "between areas")
  Rel(authenticate, getUser, "Calls: reads the pending-password flag", "between areas")
  Rel(refresh, getUser, "Calls: reads the user", "between areas")
  Rel(assignRole, effective, "Calls: actor effective access", "between areas")
  Rel(invalidator, accessCache, "Invalidates")
  Rel(reuseLog, sessionAgg, "Listens for RefreshTokenReuseDetected")

  Rel(customers, registerUser, "Calls through index.ts: opens an account, in a transaction of its own", "cross-module")
  Rel(customers, discardAccount, "Calls through index.ts: discards the account when the registration fails", "cross-module")
  Rel(customers, userKeys, "Calls through index.ts: user UUID to key", "cross-module")
  Rel(workOrders, effective, "Calls through index.ts: access of an actor", "cross-module")
  Rel(workOrders, getUser, "Calls through index.ts: the assigned mechanic", "cross-module")

  Rel(userRepo, pg, "Reads and writes", "TCP")
  Rel(userKeys, pg, "Reads", "TCP")
  Rel(sessionRepo, pg, "Reads and writes", "TCP")
  Rel(accessReader, pg, "Reads", "TCP")
  Rel(accessCache, redis, "Reads and writes", "TCP")
  Rel(revoked, redis, "Reads and writes", "TCP")

  UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")

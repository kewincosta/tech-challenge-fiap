%% C4 level 1, system context - Workshop Management API
%% Four business actors and one system. One external system, an SMTP server that takes the status
%% e-mails. This MVP integrates with no payment provider and no supplier. See architecture-overview.md.

C4Context
  title System context - Workshop Management API

  Person(customer, "Customer", "Owns vehicles, approves or rejects the budget, follows their own work orders")
  Person(advisor, "Service advisor", "Registers customers and vehicles, opens work orders, assigns mechanics, delivers, cancels")
  Person(mechanic, "Mechanic", "Diagnoses, plans parts, executes the work, withdraws and returns parts, completes")
  Person(admin, "Administrator", "Manages the catalog, the inventory, the staff accounts, applies discounts, reads metrics and trails")

  System(api, "Workshop Management API", "Centralises attendance, diagnosis, budgeting, execution, stock and delivery around the work order")
  System_Ext(mail, "SMTP server", "Mailpit, a compose container locally and a pod in prod; takes the e-mail the customer receives at every status change")

  Rel(customer, api, "Follows work orders, decides on budgets", "HTTP/JSON")
  Rel(advisor, api, "Registers, opens, assigns, delivers, cancels", "HTTP/JSON")
  Rel(mechanic, api, "Diagnoses, withdraws parts, completes", "HTTP/JSON")
  Rel(admin, api, "Administers the catalog, stock, staff and reads metrics", "HTTP/JSON")
  Rel(api, mail, "Sends the status e-mails of a work order", "SMTP")

  UpdateLayoutConfig($c4ShapeInRow="2", $c4BoundaryInRow="1")

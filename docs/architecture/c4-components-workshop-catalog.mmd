%% C4 level 3, components - Workshop Catalog
%% One module, services. Drawn anyway so all five contexts are covered uniformly, and because
%% the crossing into work-orders is the reason this context exists for anyone but an administrator.
%% Detail: docs/architecture/low-level-design/services.md

C4Component
  title Components - Workshop Catalog

  Person(admin, "Administrator", "Maintains the catalog")

  Container_Boundary(app, "NestJS application") {

    Boundary(services, "services") {
      Component(svcCtl, "ServicesController", "Controller", "Catalog administration")
      Component(createSvc, "CreateServiceUseCase", "Use case", "Adds an entry")
      Component(updateSvc, "UpdateServiceUseCase", "Use case", "Name, description, price, duration")
      Component(deactivateSvc, "DeactivateServiceUseCase", "Use case", "Status change, never a delete")
      Component(getSvc, "GetServiceUseCase / ListServicesUseCase", "Query use cases", "Reads the catalog; ServiceNotFoundError for an unknown service")
      Component(svcAgg, "Service", "Aggregate", "ServiceName, ServiceDuration, Money price, unique while active")
      Component(svcRepo, "TypeOrmServiceRepository", "Repository", "")
      Component(svcQuery, "TypeOrmServiceQueryAdapter", "Query port", "ServiceQueryPort")
      Component(svcKeys, "ServiceKeyResolver", "Key resolver", "Service UUID to internal key and back, for other modules")
    }
  }

  Component_Ext(workOrders, "work-orders", "Module", "Adds services to a work order and freezes their price into a budget round")
  ContainerDb(pg, "PostgreSQL", "PostgreSQL 16", "services")

  Rel(admin, svcCtl, "Creates, updates, deactivates, reads", "HTTPS")
  Rel(svcCtl, createSvc, "Calls")
  Rel(svcCtl, updateSvc, "Calls")
  Rel(svcCtl, deactivateSvc, "Calls")
  Rel(svcCtl, getSvc, "Calls")
  Rel(createSvc, svcAgg, "Creates")
  Rel(createSvc, svcRepo, "Saves")
  Rel(updateSvc, svcRepo, "Loads and saves")
  Rel(getSvc, svcQuery, "Reads")

  Rel(workOrders, getSvc, "Calls through index.ts: reads the service and its price when an item is added", "cross-module")
  Rel(workOrders, svcKeys, "Calls through index.ts: service UUID to key", "cross-module")

  Rel(svcRepo, pg, "Reads and writes", "TCP")
  Rel(svcQuery, pg, "Reads", "TCP")
  Rel(svcKeys, pg, "Reads", "TCP")

  UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")

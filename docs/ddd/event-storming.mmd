%% Event Storming - Workshop Management (revision 9)
%% Legend: hexagon = actor, rectangle = command, circle = domain event,
%%         double square = aggregate, rhombus = policy, stadium = work order status,
%%         parallelogram = read model. Dotted arrows cross a bounded context boundary.

flowchart LR

  classDef actor fill:#FFE7B3,stroke:#B07D00,stroke-width:1px,color:#3D2B00;
  classDef command fill:#BBD7FF,stroke:#1B4F9C,stroke-width:1px,color:#0C2547;
  classDef event fill:#FFC38A,stroke:#B35C00,stroke-width:1px,color:#4A2600;
  classDef aggregate fill:#FFF4B8,stroke:#8A7300,stroke-width:2px,color:#3A3000;
  classDef policy fill:#D8C3F5,stroke:#5B2E9E,stroke-width:1px,color:#26123F;
  classDef status fill:#CFF0D6,stroke:#1F7A3D,stroke-width:1px,color:#0E3A1D;
  classDef readmodel fill:#E6E6E6,stroke:#5A5A5A,stroke-width:1px,color:#1F1F1F;

  subgraph IAM["Identity and Access (existing, extended). Identity, credentials, document, roles"]
    direction TB
    AC_PERSON{{"Customer"}}
    AC_SERVICE_ADVISOR_I{{"Service advisor"}}
    AG_IAM[["User: name, email, CPF or CNPJ / Session / Role"]]
    CMD_REGISTER_USER["Register User"]
    CMD_CHANGE_PASSWORD["Change Password"]
    EV_USER_REGISTERED(("User Registered"))
    EV_PASSWORD_CHANGED(("Password Changed"))
    AC_PERSON --> CMD_REGISTER_USER
    AC_SERVICE_ADVISOR_I -.->|"counter registration"| CMD_REGISTER_USER
    CMD_REGISTER_USER --> AG_IAM --> EV_USER_REGISTERED
    CMD_CHANGE_PASSWORD --> AG_IAM --> EV_PASSWORD_CHANGED
    EV_USER_REGISTERED -.->|"counter account carries a temporary password"| CMD_CHANGE_PASSWORD
  end

  subgraph CUSTOMERS["Customer Management"]
    direction TB
    AC_SERVICE_ADVISOR_V{{"Service advisor"}}
    CMD_REG_CUSTOMER["Register Customer"]
    AG_CUSTOMER[["Customer: identity link, address"]]
    EV_CUSTOMER_REG(("Customer Registered"))
    CMD_REG_VEHICLE["Register Vehicle"]
    AG_VEHICLE[["Vehicle"]]
    EV_VEHICLE_REG(("Vehicle Registered"))
    AC_SERVICE_ADVISOR_V --> CMD_REG_CUSTOMER --> AG_CUSTOMER --> EV_CUSTOMER_REG
    AC_SERVICE_ADVISOR_V --> CMD_REG_VEHICLE --> AG_VEHICLE --> EV_VEHICLE_REG
    EV_CUSTOMER_REG -.->|"CustomerId, owner of the vehicle"| CMD_REG_VEHICLE
  end

  subgraph CATALOG["Workshop Catalog"]
    direction TB
    AC_ADMIN_S{{"Administrator"}}
    CMD_CREATE_SERVICE["Create Service"]
    CMD_UPDATE_SERVICE["Update Service"]
    AG_SERVICE[["Service"]]
    EV_SERVICE_CREATED(("Service Created"))
    AC_ADMIN_S --> CMD_CREATE_SERVICE --> AG_SERVICE --> EV_SERVICE_CREATED
    AC_ADMIN_S --> CMD_UPDATE_SERVICE --> AG_SERVICE
  end

  subgraph INVENTORY["Inventory (parts and supplies, one stock)"]
    direction TB
    AC_ADMIN_I{{"Administrator"}}
    CMD_CREATE_ITEM["Create Inventory Item"]
    CMD_REPLENISH["Replenish Stock"]
    CMD_CONSUME_STOCK["Consume Stock"]
    CMD_RESTORE_STOCK["Restore Stock"]
    CMD_SETTLE["Settle Stock Movements"]
    CMD_WRITE_OFF["Write Off Stock Movements"]
    AG_INVENTORY[["InventoryItem + StockMovement + history"]]
    EV_ITEM_CREATED(("Inventory Item Created"))
    EV_STOCK_UP(("Stock Replenished"))
    EV_STOCK_CONSUMED(("Stock Consumed"))
    EV_STOCK_RESTORED(("Stock Restored"))
    EV_NO_STOCK(("Insufficient Stock Detected"))
    EV_SETTLED(("Stock Movements Settled"))
    EV_WRITTEN_OFF(("Stock Movements Written Off"))
    AC_ADMIN_I --> CMD_CREATE_ITEM --> AG_INVENTORY --> EV_ITEM_CREATED
    AC_ADMIN_I --> CMD_REPLENISH --> AG_INVENTORY --> EV_STOCK_UP
    CMD_CONSUME_STOCK --> AG_INVENTORY
    CMD_RESTORE_STOCK --> AG_INVENTORY --> EV_STOCK_RESTORED
    CMD_SETTLE --> AG_INVENTORY --> EV_SETTLED
    CMD_WRITE_OFF --> AG_INVENTORY --> EV_WRITTEN_OFF
    AG_INVENTORY --> EV_STOCK_CONSUMED
    AG_INVENTORY --> EV_NO_STOCK
  end

  subgraph OPS["Workshop Operations"]
    direction TB
    AC_SERVICE_ADVISOR_O{{"Service advisor"}}
    AC_MECHANIC_O{{"Mechanic"}}
    AC_CUSTOMER_O{{"Customer"}}
    AC_ADMIN_O{{"Administrator"}}

    AG_WORKORDER[["Work Order (items + budget)"]]

    CMD_CREATE_WO["Create Work Order"]
    CMD_ADD_SERVICE["Add Requested Service"]
    CMD_ASSIGN["Assign Mechanic"]
    CMD_START_DIAG["Start Diagnosis"]
    CMD_PLAN_PART["Plan Part"]
    CMD_REMOVE_ITEM["Remove Work Order Item"]
    CMD_COMPLETE_DIAG["Complete Diagnosis"]
    CMD_SUPPLEMENTARY["Submit Supplementary Budget"]
    CMD_APPROVE["Approve Budget"]
    CMD_REJECT["Reject Budget"]
    CMD_START_EXEC["Start Execution"]
    CMD_WITHDRAW["Withdraw Part"]
    CMD_RETURN["Return Part"]
    CMD_DISCOUNT["Apply Discount"]
    CMD_COMPLETE_WO["Complete Work Order"]
    CMD_DELIVER["Deliver Vehicle"]
    CMD_CANCEL["Cancel Work Order"]

    EV_WO_CREATED(("Work Order Created"))
    EV_SERVICE_ADDED(("Service Added To Work Order"))
    EV_MECHANIC_ASSIGNED(("Mechanic Assigned"))
    EV_DIAG_STARTED(("Diagnosis Started"))
    EV_PART_PLANNED(("Part Planned For Work Order"))
    EV_ITEM_REMOVED(("Item Removed From Work Order"))
    EV_DIAG_DONE(("Diagnosis Completed"))
    EV_BUDGET_GENERATED(("Budget Generated"))
    EV_SUPPLEMENTARY(("Supplementary Budget Generated"))
    EV_BUDGET_SENT(("Budget Sent"))
    EV_BUDGET_APPROVED(("Budget Approved"))
    EV_BUDGET_REJECTED(("Budget Rejected"))
    EV_EXEC_STARTED(("Execution Started"))
    EV_PART_WITHDRAWN(("Part Withdrawn"))
    EV_PART_RETURNED(("Part Returned"))
    EV_DISCOUNT_APPLIED(("Discount Applied"))
    EV_WO_COMPLETED(("Work Order Completed"))
    EV_VEHICLE_DELIVERED(("Vehicle Delivered"))
    EV_WO_CANCELED(("Work Order Canceled"))

    POL_NOTIFY{"WHEN Budget Sent THEN make it readable by the customer"}
    POL_START_EXEC{"WHEN Budget Approved THEN start execution"}
    POL_CONSUME{"WHEN Part Withdrawn THEN consume stock"}
    POL_RESTORE{"WHEN Part Returned THEN restore stock"}
    POL_SETTLE{"WHEN Vehicle Delivered THEN settle the movements"}
    POL_CANCEL{"WHEN Work Order Canceled THEN write off the movements as a loss"}
    AG_TRAIL[["WorkOrderEvent: append only trail, written with the aggregate"]]

    subgraph LIFECYCLE["Work order status"]
      direction TB
      ST_RECEIVED(["RECEIVED"])
      ST_DIAGNOSIS(["IN_DIAGNOSIS"])
      ST_AWAITING(["AWAITING_APPROVAL"])
      ST_EXECUTION(["IN_EXECUTION"])
      ST_COMPLETED(["COMPLETED"])
      ST_DELIVERED(["DELIVERED"])
      ST_CANCELED(["CANCELED"])
      ST_RECEIVED --> ST_DIAGNOSIS --> ST_AWAITING --> ST_EXECUTION --> ST_COMPLETED --> ST_DELIVERED
      ST_AWAITING -.->|"budget rejected"| ST_DIAGNOSIS
      ST_RECEIVED -.-> ST_CANCELED
      ST_DIAGNOSIS -.-> ST_CANCELED
      ST_AWAITING -.-> ST_CANCELED
      ST_EXECUTION -.->|"extra work found, supplementary budget"| ST_AWAITING
      ST_EXECUTION -.->|"customer gives up, admin only"| ST_CANCELED
    end

    AC_SERVICE_ADVISOR_O --> CMD_CREATE_WO --> AG_WORKORDER --> EV_WO_CREATED --> ST_RECEIVED
    AC_SERVICE_ADVISOR_O --> CMD_ADD_SERVICE --> AG_WORKORDER
    AC_MECHANIC_O --> CMD_ADD_SERVICE
    AG_WORKORDER --> EV_SERVICE_ADDED
    AC_SERVICE_ADVISOR_O --> CMD_ASSIGN --> AG_WORKORDER
    AG_WORKORDER --> EV_MECHANIC_ASSIGNED
    AC_MECHANIC_O --> CMD_START_DIAG --> AG_WORKORDER
    AG_WORKORDER --> EV_DIAG_STARTED --> ST_DIAGNOSIS
    AC_MECHANIC_O --> CMD_PLAN_PART --> AG_WORKORDER
    AG_WORKORDER --> EV_PART_PLANNED
    AC_MECHANIC_O --> CMD_REMOVE_ITEM --> AG_WORKORDER
    AG_WORKORDER --> EV_ITEM_REMOVED
    AC_MECHANIC_O --> CMD_COMPLETE_DIAG --> AG_WORKORDER
    AC_MECHANIC_O --> CMD_SUPPLEMENTARY --> AG_WORKORDER
    AG_WORKORDER --> EV_SUPPLEMENTARY --> EV_BUDGET_SENT
    AG_WORKORDER --> EV_DIAG_DONE --> EV_BUDGET_GENERATED --> EV_BUDGET_SENT --> ST_AWAITING
    EV_BUDGET_SENT --> POL_NOTIFY
    AC_CUSTOMER_O --> CMD_APPROVE
    AC_SERVICE_ADVISOR_O -.->|"decides on the customer's behalf"| CMD_APPROVE
    CMD_APPROVE --> AG_WORKORDER
    AG_WORKORDER --> EV_BUDGET_APPROVED --> POL_START_EXEC --> CMD_START_EXEC --> AG_WORKORDER
    AC_CUSTOMER_O --> CMD_REJECT --> AG_WORKORDER
    AG_WORKORDER --> EV_BUDGET_REJECTED --> ST_DIAGNOSIS
    AG_WORKORDER --> EV_EXEC_STARTED --> ST_EXECUTION
    AC_MECHANIC_O --> CMD_WITHDRAW --> AG_WORKORDER
    AG_WORKORDER --> EV_PART_WITHDRAWN --> POL_CONSUME
    AC_MECHANIC_O --> CMD_RETURN --> AG_WORKORDER
    AG_WORKORDER --> EV_PART_RETURNED --> POL_RESTORE
    AC_ADMIN_O --> CMD_DISCOUNT --> AG_WORKORDER
    AG_WORKORDER --> EV_DISCOUNT_APPLIED
    AC_MECHANIC_O --> CMD_COMPLETE_WO --> AG_WORKORDER
    AG_WORKORDER --> EV_WO_COMPLETED --> ST_COMPLETED
    AC_SERVICE_ADVISOR_O --> CMD_DELIVER --> AG_WORKORDER
    AG_WORKORDER --> EV_VEHICLE_DELIVERED --> ST_DELIVERED
    EV_VEHICLE_DELIVERED --> POL_SETTLE
    AC_SERVICE_ADVISOR_O --> CMD_CANCEL --> AG_WORKORDER
    AG_WORKORDER --> EV_WO_CANCELED --> ST_CANCELED
    EV_WO_CANCELED --> POL_CANCEL
    AG_WORKORDER -.->|"every recorded event, same transaction"| AG_TRAIL
    EV_WO_CANCELED -.->|"successor work order for the extra work"| CMD_CREATE_WO
  end

  subgraph READS["Read models"]
    direction TB
    AC_CUSTOMER_R{{"Customer"}}
    AC_ADMIN_R{{"Administrator"}}
    Q_MY_WO[/"Get My Work Order Status"/]
    Q_LIST_WO[/"List Work Orders"/]
    Q_WO_DETAIL[/"Get Work Order"/]
    Q_AVG_TIME[/"Get Average Execution Time"/]
    Q_MOVEMENTS[/"Get Item Movement History"/]
    Q_SHORTAGES[/"List Stock Shortages"/]
    Q_TRAIL[/"Get Work Order Trail"/]
    AC_CUSTOMER_R --> Q_MY_WO
    AC_ADMIN_R --> Q_LIST_WO
    AC_ADMIN_R --> Q_WO_DETAIL
    AC_ADMIN_R --> Q_AVG_TIME
    AC_ADMIN_R --> Q_MOVEMENTS
    AC_ADMIN_R --> Q_SHORTAGES
    AC_ADMIN_R --> Q_TRAIL
  end

  %% Cross context interactions
  CMD_REG_CUSTOMER -.->|"identity, one customer per user, CUSTOMER role"| AG_IAM
  CMD_CREATE_WO -.->|"CustomerId, customer must be active"| AG_CUSTOMER
  CMD_ASSIGN -.->|"assignee must hold the MECHANIC role"| AG_IAM
  CMD_CREATE_WO -.->|"VehicleId, snapshot plate, brand, model, year"| AG_VEHICLE
  CMD_ADD_SERVICE -.->|"name, price and duration"| AG_SERVICE
  CMD_PLAN_PART -.->|"name, sku and unit price, stock untouched"| AG_INVENTORY
  CMD_WITHDRAW -.->|"charged at the budgeted price"| AG_WORKORDER
  POL_CONSUME -.->|"command, may be refused"| CMD_CONSUME_STOCK
  POL_RESTORE -.-> CMD_RESTORE_STOCK
  EV_NO_STOCK -.->|"shortage becomes visible"| Q_SHORTAGES
  POL_SETTLE -.-> CMD_SETTLE
  POL_CANCEL -.-> CMD_WRITE_OFF
  EV_NO_STOCK -.->|"withdrawal refused, replenish first"| CMD_REPLENISH
  AC_CUSTOMER_O -.->|"JWT principal and permissions"| AG_IAM
  Q_MY_WO -.->|"ownership check against the customer of the work order"| AG_WORKORDER
  Q_LIST_WO -.-> AG_WORKORDER
  Q_WO_DETAIL -.-> AG_WORKORDER
  Q_AVG_TIME -.->|"Execution Started to Work Order Completed"| AG_WORKORDER
  Q_MOVEMENTS -.-> AG_INVENTORY
  Q_SHORTAGES -.->|"pending withdrawals against the count on hand"| AG_INVENTORY
  Q_TRAIL -.-> AG_TRAIL

  class AC_PERSON,AC_SERVICE_ADVISOR_I,AC_SERVICE_ADVISOR_V,AC_ADMIN_S,AC_ADMIN_I,AC_SERVICE_ADVISOR_O,AC_MECHANIC_O,AC_CUSTOMER_O,AC_ADMIN_O,AC_CUSTOMER_R,AC_ADMIN_R actor;
  class CMD_REGISTER_USER,CMD_CHANGE_PASSWORD,CMD_REG_CUSTOMER,CMD_REG_VEHICLE,CMD_CREATE_SERVICE,CMD_UPDATE_SERVICE,CMD_CREATE_ITEM,CMD_REPLENISH,CMD_CONSUME_STOCK,CMD_RESTORE_STOCK,CMD_SETTLE,CMD_WRITE_OFF,CMD_CREATE_WO,CMD_ADD_SERVICE,CMD_ASSIGN,CMD_START_DIAG,CMD_PLAN_PART,CMD_REMOVE_ITEM,CMD_COMPLETE_DIAG,CMD_SUPPLEMENTARY,CMD_APPROVE,CMD_REJECT,CMD_START_EXEC,CMD_WITHDRAW,CMD_RETURN,CMD_DISCOUNT,CMD_COMPLETE_WO,CMD_DELIVER,CMD_CANCEL command;
  class EV_USER_REGISTERED,EV_PASSWORD_CHANGED,EV_CUSTOMER_REG,EV_VEHICLE_REG,EV_SERVICE_CREATED,EV_ITEM_CREATED,EV_STOCK_UP,EV_STOCK_CONSUMED,EV_STOCK_RESTORED,EV_NO_STOCK,EV_SETTLED,EV_WRITTEN_OFF,EV_WO_CREATED,EV_SERVICE_ADDED,EV_MECHANIC_ASSIGNED,EV_DIAG_STARTED,EV_PART_PLANNED,EV_ITEM_REMOVED,EV_DIAG_DONE,EV_BUDGET_GENERATED,EV_SUPPLEMENTARY,EV_BUDGET_SENT,EV_BUDGET_APPROVED,EV_BUDGET_REJECTED,EV_EXEC_STARTED,EV_PART_WITHDRAWN,EV_PART_RETURNED,EV_DISCOUNT_APPLIED,EV_WO_COMPLETED,EV_VEHICLE_DELIVERED,EV_WO_CANCELED event;
  class AG_IAM,AG_CUSTOMER,AG_VEHICLE,AG_SERVICE,AG_INVENTORY,AG_WORKORDER,AG_TRAIL aggregate;
  class POL_NOTIFY,POL_START_EXEC,POL_CONSUME,POL_RESTORE,POL_SETTLE,POL_CANCEL policy;
  class ST_RECEIVED,ST_DIAGNOSIS,ST_AWAITING,ST_EXECUTION,ST_COMPLETED,ST_DELIVERED,ST_CANCELED status;
  class Q_MY_WO,Q_LIST_WO,Q_WO_DETAIL,Q_AVG_TIME,Q_MOVEMENTS,Q_SHORTAGES,Q_TRAIL readmodel;

NODE_ENV=development
PORT=3000

APP_HOST_PORT=13000
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

DATABASE_HOST=localhost
DATABASE_PORT=15432
DATABASE_USER=workshop
DATABASE_PASSWORD=workshop
DATABASE_NAME=workshop

REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_DB=0

JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# The outbox completes the work one module hands to another. The processor looks for due steps every
# OUTBOX_POLL_INTERVAL_MS milliseconds, and 0 turns it off. An armed step is undone after
# OUTBOX_GRACE_SECONDS, and a step that keeps failing is marked failed after OUTBOX_MAX_ATTEMPTS.
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_GRACE_SECONDS=300
OUTBOX_MAX_ATTEMPTS=10

# The application sends the customer an e-mail at every status change of a work order. Mailpit
# (docker compose up -d mailpit) catches them, and its inbox is at http://localhost:8025. Leave
# SMTP_USER and SMTP_PASSWORD empty for a server that asks for no login.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Oficina <no-reply@workshop.local>"

# The address customers reach the API at, without a trailing slash. The budget links in the
# e-mails start with it, and it is the host port that docker-compose.yml publishes.
APP_PUBLIC_URL=http://localhost:13000

ADMIN_EMAIL=admin@workshop.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_DOCUMENT=28768733119

# Password given to every account npm run seed creates. Local environments only.
SEED_PASSWORD=Str0ngPassword
